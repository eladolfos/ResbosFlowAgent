# templates/ResBos2W/resbos_w.config -- ResBos2 settings for the W grid of [campaign] w_grid = resbos2 (run_process.py).
#
# XSec = Resummation: ResBos2 computes the CSS function W = L0, A3 on a (Q, y, qT) mesh and writes Grids/ResBos_GridFile_0.out;
# run_process.py turns the per-Q files into the "Main data grid" of resbos_root. One run = one Q node (qMin = qMax).
#
# run_process.py SETS these keys for every run, from the Legacy main .in of the campaign, so that ResBos2 computes what Legacy
# was set to compute: beam, ECM, Process, PDF, iSet, KinematicCorrection, AOrder, BOrder, COrder, C1, C2, C3 (= C1/B0, C2,
# C3/B0 of Legacy), NonPert (BLNY only), bMax, Q0, g, scale, muF, muR, mc, mb, qMin, qMax, qtMin, qtMax, yMin, yMax, nThreads.
# Everything else is read from here: edit it to change the electroweak inputs (values of Yao's collider config).
# The ZU/ZD 8 TeV validation (ResBos2/Legacy W = 1.00 +- 0.02 for 5 GeV < qT < 2Q) used mT = 173.5, mu = md = ms = 0 here and
# Legacy's own mW = 80.358, mZ = 91.118; the values now in this file and written to Legacy were not re-validated, PertOrder/AsymOrder/DeltaSigmaOrder, the
# number of VEGAS calls (not used: only the grid is) or the mass/width inputs.
#
# MASSES, WIDTHS, EW INPUTS: [physics] in the .ini overrides every value of this file that run_process.py knows (mT mW mZ mH gamT gamW gamZ gamH
# mu md ms mc mb GF AlphaEM0 AlphaEMMZ EWMassScheme) and writes the same masses/widths into the Legacy .in and resbos.in. Unset keys:
# mW mZ mH gamW gamZ and the ResBos2-only ones are taken from here; mT mu md ms mc mb from the Legacy template (this file carries the same values). mT, mW and mZ are also written into the header
# of the assembled grid, because resbos_root rescales W and Z0 grids by (M/M_grid)^2.
#
#ResBos2 Configuration File
Version = 2.0.1

#####################
# Running Mode Info #
#####################
mode = MCFull 
XSec = Resummation

####################
# VEGAS PARAMETERS #
####################
itmax1 = 1
ncall1 = 200
itmax2 = 1
ncall2 = 200
iSeed = 6270355 

################
# Process Info #
################
beam = pp
ECM = 8000
Process = ZU
CKM = true
HiggsDecay = AA
PDF = CT25NLO
iSet = 0
KinematicCorrection = true

##########################
# Resummation Parameters #
##########################
# Resummation Orders and Scheme
scheme = CSS
AOrder = 3
BOrder = 2
COrder = 1
HOrder = 2

# Scales
C1 = 1
C2 = 1
C3 = 1

# Non-Pert Info
NonPert = BLNY
bMax = 0.5
Q0 = 1.6
ngag = 1
g = 0.21, 0.68, -0.126

#####################################
# Fixed-Order/Asymptotic Parameters #
#####################################
PertOrder = 1
AsymOrder = 1
DeltaSigmaOrder = 2
scale = MT
muF = 1
muR = 1

#############
# EW Inputs #
#############
EWMassScheme = OnShell
mT = 172.
gamT = 0
mH = 125
gamH = 0.004
mW = 80.385
gamW = 2.108
mZ = 91.1876
gamZ = 2.4952

# Quark Masses
mu = 0.06983
md = 0.06984
ms = 0.15
mc = 1.3
mb = 4.75

# EWInputs is not read: GFMWMZ is hard-wired in Electroweak.cc
EWInputs = GFMWMZ
GF = 1.1663787E-5 
AlphaEMOrder = 1
AlphaEM0 = 0.00729735
AlphaEMMZ = 0.007763340902
# sinw2 is not read: ResBos2 uses sin^2(theta_W) = 1 - mW^2/mZ^2
sinw2 = 0.22255

#########################
# Cuts: For particles   #
# Note: -1 means no max #
#########################
# Resummation Phase Space Cuts
qMin = 46
qMax = 66
qtMin = 0
qtMax = 1500
yMin = -6.0
yMax = 6.0

# Lepton cuts
ptlMin = 0
ptlMax = -1
ylMin = -10
ylMax = 10

# Missing Energy Cut
METMin = 0
METMax = -1

# DeltaR cuts
drllMin = 0
drllMax = -1

# Pt cut on sorted leptons
ptl1Min = 0
ptl2Min = 0
ptl1Max = -1
ptl2Max = -1

##############
# Histograms #
##############
HistogramMode = BuiltIn # Other options are YODA and ROOT
WriteEvent = false

###################
# Running Options #
###################
nThreads = 1
GridGen = true
