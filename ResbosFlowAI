#!/bin/bash
# ResbosFlowAI -- start the ResbosFlowAgent assistant.
#
# Run it from anywhere (put a link on your PATH once:  ln -s "$PWD/ResbosFlowAI" ~/.local/bin/ResbosFlowAI).
# It checks that python3 and the agent are installed and starts the assistant with the onboarding: it asks whether you want your software and
# paths reviewed, finds out how you reach your cluster (and helps with SSH if you need it), and then sends a test.
# If local/remote.conf exists from an earlier session, it offers to open the SSH connection (you type the password/passphrase/2FA here, never to the assistant).
#
# Environment: RESBOSFLOWAI_AGENT=<command>  start another agent than `claude` (it must read AGENTS.md).

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  D="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"; [[ "$SRC" != /* ]] && SRC="$D/$SRC"
done
REPO="$(cd -P "$(dirname "$SRC")" && pwd)"
cd "$REPO" || exit 1
AGENT="${RESBOSFLOWAI_AGENT:-claude}"
CONF="$REPO/local/remote.conf"

say()  { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || { say "ResbosFlowAI: '$1' not found. $2"; MISSING=1; }; }

say "ResbosFlowAI  ($REPO)"
MISSING=0
need python3 "Install Python 3."
need "$AGENT" "Install Claude Code (https://claude.com/claude-code), or set RESBOSFLOWAI_AGENT to another agent that reads AGENTS.md."
[ "$MISSING" -eq 0 ] || exit 1

# --- SSH is NOT asked here. Whether jobs run on this machine, on the cluster the assistant is installed on, or on a cluster reached over SSH,
# and how to set up SSH, is decided inside the onboarding (skills/resbosflow and skills/setup-ssh), where the assistant can inspect this computer first.
# If an earlier session already wrote local/remote.conf, keep the persistent connection open for it.
if [ -f "$CONF" ]; then
  ALIAS="$(sed -n 's/^host *= *\([^ #]*\).*/\1/p' "$CONF" | head -1)"
  if [ -n "$ALIAS" ] && command -v ssh >/dev/null 2>&1; then
    if ! ssh -O check "$ALIAS" >/dev/null 2>&1; then
      say ""
      say "The SSH connection to '$ALIAS' (from local/remote.conf) is not open."
      read -r -p "Open it now? You type the password / passphrase / 2FA here, never to the assistant. [Y/n]: " YN
      if [ "${YN:-Y}" != "n" ] && [ "${YN:-Y}" != "N" ]; then
        ssh -fN "$ALIAS" || say "Could not open it. The assistant can help you find out why."
      fi
    fi
    if ssh -O check "$ALIAS" >/dev/null 2>&1; then say "SSH connection to '$ALIAS': open."; fi
  fi
fi

PROMPT="Start the ResbosFlowAgent onboarding: follow the skill 'resbosflow'. Greet me in one or two sentences, say in three lines what you will do, show the short menu of what you can compute (orders NLO, resNLO, LO; collider W/Z/photon; fixed-target Drell-Yan; from docs/CAPABILITIES.md), and ask whether I want you to review my software and paths now. Do not assume how I reach my cluster and do not ask for an SSH alias yet: the onboarding finds out. Do not run anything on the cluster until I answer."
say ""
say "Starting the assistant ($AGENT)..."
exec "$AGENT" "$PROMPT"
